{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 500,
  "background": "white",
  "title": {
    "text": "Where the Cameras Point",
    "subtitle": "Photo-record volume by state (2010 onward)",
    "fontSize": 16,
    "font": "Georgia",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 750,
    "translate": [
      400,
      260
    ]
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eaf2f8"
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            10,
            10
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cdd9e3",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/state_boundaries.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f1ea",
        "stroke": "#8a8a8a",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/chart05_state_counts.csv"
      },
      "mark": {
        "type": "square",
        "opacity": 0.82,
        "stroke": "#1a4971",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "occurrences",
          "type": "quantitative",
          "title": "Photo Records",
          "scale": {
            "range": [
              250,
              6500
            ]
          },
          "legend": {
            "format": "~s"
          }
        },
        "color": {
          "value": "#2b6cb0"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "occurrences",
            "type": "quantitative",
            "title": "Records",
            "format": ","
          }
        ]
      }
    }
  ]
}