{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "background": "white",
  "title": {
    "text": "The Protection Gap",
    "subtitle": "State-listed threatened species with no federal EPBC protection",
    "fontSize": 16,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false, "labelFont": "Helvetica, Arial, sans-serif", "titleFont": "Helvetica, Arial, sans-serif", "domainColor": "#ccc", "tickColor": "#ccc"}
  },
  "data": {"url": "data/chart_protection_gap.csv"},
  "transform": [
    {"fold": ["also_epbc_listed", "state_only_gap"], "as": ["status", "count"]},
    {"calculate": "datum.status == 'also_epbc_listed' ? 'Also Federally Protected' : 'State-Only (No Federal Protection)'", "as": "status_label"}
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "state", "type": "nominal",
      "sort": {"field": "state_only_gap", "order": "descending"},
      "axis": {"title": null, "labelAngle": 0}
    },
    "y": {
      "field": "count", "type": "quantitative",
      "axis": {"title": "Number of Species"}
    },
    "color": {
      "field": "status_label", "type": "nominal",
      "scale": {
        "domain": ["State-Only (No Federal Protection)", "Also Federally Protected"],
        "range": ["#DBC3E3", "#6d4c41"]
      },
      "legend": {"title": null, "orient": "bottom", "labelFont": "Helvetica, Arial, sans-serif"}
    },
    "order": {"field": "status_label", "sort": "descending"},
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "status_label", "type": "nominal", "title": "Status"},
      {"field": "count", "type": "quantitative", "title": "Species"}
    ]
  }
}