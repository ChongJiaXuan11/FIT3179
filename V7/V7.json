{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "title": {
    "text": "Following the Season",
    "subtitle": "Bird photo-record density across four seasonal snapshots",
    "fontSize": 18,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "config": {
    "view": {"stroke": null},
    "header": {"labelFont": "Helvetica, Arial, sans-serif", "labelFontWeight": "bold", "labelFontSize": 13}
  },
  "data": {"url": "data/chart07_dot_density.csv"},
  "facet": {
    "field": "season",
    "type": "nominal",
    "sort": ["Summer (Jan)", "Autumn (Apr)", "Winter (Jul)", "Spring (Oct)"],
    "header": {"title": null}
  },
  "spec": {
    "width": 480,
    "height": 430,
    "projection": {
      "type": "mercator",
      "center": [134, -28],
      "scale": 592,
      "translate": [240.0, 215.0]
    },
    "layer": [
      {
        "data": {"sphere": true},
        "mark": {"type": "geoshape", "fill": "#eaf2f8"}
      },
      {"data": {"graticule": {"step": [10, 10]}}, "mark": {"type": "geoshape", "fill": null, "stroke": "#cdd9e3", "strokeWidth": 0.6}},
      {
        "data": {
          "url": "data/state_boundaries.topojson",
          "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
        },
        "mark": {"type": "geoshape", "fill": "#f4f1ea", "stroke": "#b5b5b5", "strokeWidth": 0.6}
      },
      {
        "transform": [{"calculate": "'1 dot \u2248 75 birds photo records'", "as": "legend_label"}],
        "mark": {"type": "circle", "size": 4, "opacity": 0.5},
        "encoding": {
          "longitude": {"field": "lon", "type": "quantitative"},
          "latitude": {"field": "lat", "type": "quantitative"},
          "color": {
            "field": "legend_label", "type": "nominal",
            "scale": {"range": ["#E49B0F"]},
            "legend": {"title": null, "orient": "bottom", "symbolSize": 60, "labelFontSize": 12, "labelFont": "Helvetica, Arial, sans-serif"}
          }
        }
      }
    ]
  },
  "columns": 2
}