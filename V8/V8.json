{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "background": "white",
  "title": {
    "text": "National Parks in Focus",
    "subtitle": "Top 15 parks by photo-record density per 1,000 hectares (2010 onward)",
    "fontSize": 18,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false, "labelFont": "Helvetica, Arial, sans-serif", "titleFont": "Helvetica, Arial, sans-serif"}
  },
  "data": {"url": "data/chart08_top15_parks.csv"},
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2, "color": "#ccc"},
      "encoding": {
        "y": {
          "field": "NAME", "type": "nominal",
          "sort": ["Dandenong Ranges", "Garigal", "Cleland", "Onkaparinga River", "Berowra Valley", "Tamborine", "Barron Gorge", "Glass House Mountains", "Heathcote", "Khappinghat", "John Forrest", "Tarra-Bulga", "Grey Peaks", "Mornington Peninsula", "Midgegooroo"],
          "title": null
        },
        "x": {
          "field": "occurrences_per_1000ha", "type": "quantitative",
          "title": "Records per 1,000ha", "axis": {"format": "~s"}, "scale": {"zero": true}
        },
        "x2": {"datum": 0}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 130, "stroke": "#1a1a1a", "strokeWidth": 0.6},
      "encoding": {
        "y": {
          "field": "NAME", "type": "nominal",
          "sort": ["Dandenong Ranges", "Garigal", "Cleland", "Onkaparinga River", "Berowra Valley", "Tamborine", "Barron Gorge", "Glass House Mountains", "Heathcote", "Khappinghat", "John Forrest", "Tarra-Bulga", "Grey Peaks", "Mornington Peninsula", "Midgegooroo"],
          "title": null
        },
        "x": {"field": "occurrences_per_1000ha", "type": "quantitative"},
        "color": {
          "field": "STATE", "type": "nominal",
          "scale": {
            "domain": ["VIC", "NSW", "SA", "QLD", "WA"],
            "range": ["#2e7d32", "#1565c0", "#f9a825", "#6a1b9a", "#00838f"]
          },
          "legend": {"title": "State", "orient": "bottom", "direction": "horizontal", "columns": 5}
        },
        "tooltip": [
          {"field": "NAME", "type": "nominal", "title": "Park"},
          {"field": "STATE", "type": "nominal", "title": "State"},
          {"field": "occurrences_per_1000ha", "type": "quantitative", "title": "Per 1,000ha", "format": ",.0f"},
          {"field": "occurrences", "type": "quantitative", "title": "Total Records", "format": ","},
          {"field": "area_hectares", "type": "quantitative", "title": "Area (ha)", "format": ",.0f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.NAME == 'Dandenong Ranges'"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 10, "font": "Helvetica, Arial, sans-serif", "fontWeight": "bold", "color": "#1a1a1a"},
      "encoding": {
        "y": {
          "field": "NAME", "type": "nominal",
          "sort": ["Dandenong Ranges", "Garigal", "Cleland", "Onkaparinga River", "Berowra Valley", "Tamborine", "Barron Gorge", "Glass House Mountains", "Heathcote", "Khappinghat", "John Forrest", "Tarra-Bulga", "Grey Peaks", "Mornington Peninsula", "Midgegooroo"]
        },
        "x": {"field": "occurrences_per_1000ha", "type": "quantitative"},
        "text": {"value": "near Melbourne"}
      }
    }
  ]
}