{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 420,
  "background": "white",
  "title": {
    "text": "Where the Record Actually Is",
    "subtitle": "Photo-record volume by ecological bioregion (2010 onward)",
    "fontSize": 18,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "config": {"view": {"stroke": null}},
  "projection": {"type": "mercator", "center": [134, -28], "scale": 600, "translate": [375, 218]},
  "layer": [
    {"data": {"sphere": true}, "mark": {"type": "geoshape", "fill": "#eaf2f8"}},
    {"data": {"graticule": {"step": [10, 10]}}, "mark": {"type": "geoshape", "fill": null, "stroke": "#cdd9e3", "strokeWidth": 0.6}},
    {
      "data": {
        "url": "data/ibra_simplified.topojson",
        "format": {
          "type": "topojson",
          "feature": "Interim_Biogeographic_Regionalisation_for_Australia_(IBRA)_Version_7.1_(Regions)"
        }
      },
      "transform": [
        {
          "lookup": "properties.REG_NAME_7",
          "from": {
            "data": {"url": "data/bioregion_occurrences.csv"},
            "key": "bioregion",
            "fields": ["occurrences"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.3},
      "encoding": {
        "color": {
          "field": "occurrences", "type": "quantitative",
          "title": "Photo Records",
          "scale": {"type": "symlog", "scheme": "blues"},
          "legend": {"format": "~s", "orient": "bottom", "labelFont": "Helvetica, Arial, sans-serif", "titleFont": "Helvetica, Arial, sans-serif"}
        },
        "tooltip": [
          {"field": "properties.REG_NAME_7", "type": "nominal", "title": "Bioregion"},
          {"field": "occurrences", "type": "quantitative", "title": "Records", "format": ","}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 157.0, "lat": -23.3, "label": "South Eastern QLD:"},
          {"lon": 157.0, "lat": -24.8, "label": "most documented"}
        ]
      },
      "mark": {"type": "text", "align": "left", "dx": 0, "dy": 0, "fontSize": 9, "font": "Helvetica, Arial, sans-serif", "fontWeight": "bold", "color": "#1a4971"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}