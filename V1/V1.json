{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "background": "white",
  "title": {
    "text": "Who Gets the Spotlight?",
    "subtitle": "Total ALA photographic occurrence records by taxon group (2010 onward)",
    "fontSize": 18,
    "font": "Helvetica, Arial, sans-serif",
    "subtitleFont": "Helvetica, Arial, sans-serif",
    "subtitleColor": "#666",
    "anchor": "start"
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false, "labelFont": "Helvetica, Arial, sans-serif", "titleFont": "Helvetica, Arial, sans-serif", "domainColor": "#ccc", "tickColor": "#ccc"}
  },
  "data": {"url": "data/chart01_taxon_group_counts.csv"},
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusTopLeft": 2, "cornerRadiusTopRight": 2},
      "encoding": {
        "x": {
          "field": "taxon_group", 
          "type": "nominal",
          "sort": ["Plants", "Insects", "Birds", "Mammals", "Reptiles", "Amphibians"],
          "axis": {"labelAngle": 0, "title": null}
        },
        "y": {
          "field": "record_count", 
          "type": "quantitative",
          "axis": {"title": "Photo Records", "format": "~s"}
        },
        "color": {
          "field": "taxon_group", "type": "nominal",
          "scale": {
            "domain": ["Plants", "Insects", "Birds", "Mammals", "Reptiles", "Amphibians"],
            "range": ["#DBE3C3", "#ccc", "#ccc", "#ccc", "#ccc", "#ccc"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "taxon_group", "type": "nominal", "title": "Taxon Group"},
          {"field": "record_count", "type": "quantitative", "title": "Records", "format": ","}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.taxon_group == 'Plants'"}],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "fontSize": 11,
        "font": "Helvetica, Arial, sans-serif",
        "fontWeight": "bold",
        "color": "#1a4971"
      },
      "encoding": {
        "x": {
          "field": "taxon_group", 
          "type": "nominal",
          "sort": ["Plants", "Insects", "Birds", "Mammals", "Reptiles", "Amphibians"]
        },
        "y": {"field": "record_count", "type": "quantitative"},
        "text": {"value": "#1 — 37% of all records"}
      }
    }
  ]
}